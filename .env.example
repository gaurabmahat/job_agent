# Copy this file to .env and fill in your real details

# Personal info
YOUR_NAME=Your Full Name
YOUR_LOCATION=Your City, Country
YOUR_EMAIL=your.email@example.com
YOUR_PHONE=+1234567890
YOUR_PORTFOLIO=your-portfolio-url.com
YOUR_GITHUB=github.com/yourusername
YOUR_LINKEDIN=linkedin.com/in/yourprofile

# Job search
JOB_KEYWORDS=software developer,frontend developer,full stack developer
MAX_JOBS_PER_KEYWORD=5

# AI settings
OLLAMA_MODEL=llama3.2

# Your skills (pipe-separated categories)
YOUR_SKILLS=Frontend: React TypeScript JavaScript | Backend: Node.js Python | Tools: Git Docker

# Your background summary (used by AI to write cover letter)
YOUR_BACKGROUND=Brief summary of your experience, education, and skills.

# Browser for Selenium
SELENIUM_BROWSER=Browser for Selenium
